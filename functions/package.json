{
  "name": "elytron-dash2board-functions",
  "description": "Provisionamento de personas, custom claims e trilha de auditoria do Elytron Dash2Board",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "TS_NODE_PROJECT=test/tsconfig.json firebase --config ../firebase.json --project elytron-d2b-dev emulators:exec --only firestore,auth \"mocha\""
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "firebase-tools": "^15.28.1",
    "mocha": "^11.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
