# ---------------------------------------------------------------------------
# SEGREDOS - nunca versionar
# ---------------------------------------------------------------------------
# Obs.: lib/firebase_options.dart PODE ser versionado (as chaves do Firebase
# para cliente são públicas por design; a proteção real está nas
# security rules e no App Check). Já os arquivos abaixo, não:
ios/Runner/GoogleService-Info.plist
android/app/google-services.json
.env
.env.*
service-account*.json

# Node (qualquer subprojeto: functions/, scripts/seed/, ...)
**/node_modules/
functions/lib/
scripts/seed/lib/
functions/.env
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# Obs.: .firebaserc É VERSIONADO. Ids de projeto não são segredo, e deixá-lo
# fora do repositório obriga cada desenvolvedor a recriá-lo à mão - foi a
# origem do achado A-01 da auditoria (alias apontando para projeto inexistente).

# scaffold temporário do bootstrap
_scaffold/

# Saídas locais de ferramenta
audit-report.txt
coverage/
*.log
lcov.info

# Config local do Dart & Flutter DevTools (por máquina, não por projeto)
devtools_options.yaml
